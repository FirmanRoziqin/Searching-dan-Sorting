def linear_serch(arr, target):
    for i in range(len(arr)):
        if arr[i] == target:
            return i
    return -1
data = [12, 7, 25, 9, 15]
dicari = 9

hasil = linear_serch(data, dicari)

if hasil != -1:
    print("Angka", dicari, "ada indeks ke:", hasil)
else:
    print("Tidak Ditemukan")
