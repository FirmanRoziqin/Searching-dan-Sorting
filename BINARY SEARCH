def binary_serch(arr, target):
    left = 0
    right = len(arr) -1

    while left <= right:
        mid = (left + right) // 2
        if arr[mid] == target:
            return mid
        elif target < arr[mid]:
            right = mid -1
        else:
            left = mid + 1
    return -1

data = [10, 20, 30, 40, 50]
dicari = 40
hasil = binary_serch(data, dicari)

if hasil != -1:
    print("Angka", dicari, "ada indeks ke:", hasil)
else:
    print("Tidak Ditemukan")
